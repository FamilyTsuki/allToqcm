{
  "name": "all-to-qcm",
  "version": "1.0.0",
  "description": "Clean Code QCM Creator and Runner using Node.js and PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "db:migrate": "node src/infrastructure/database/migrate.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "prettier": "^3.5.2"
  }
}

